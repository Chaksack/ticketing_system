# postgres connection string (Neon, RDS, etc.)
DATABASE_URL=

# gmail smtp (used to send staff invite emails)
NUXT_GMAIL_USER=
NUXT_GMAIL_APP_PASSWORD=

# session cookie signing secret (32+ random chars)
NUXT_SESSION_PASSWORD=

# web push (VAPID) - generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
NUXT_PUBLIC_VAPID_PUBLIC_KEY=
NUXT_VAPID_PRIVATE_KEY=
NUXT_VAPID_SUBJECT=mailto:you@example.com

# used to build links in emails (invite links, etc.)
NUXT_SITE_URL=http://localhost:3000
