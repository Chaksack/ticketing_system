# postgres connection string (Neon, RDS, etc.)
DATABASE_URL=

# gmail api (sends AND receives staff invite / password reset / ticket-reply emails) - see
# README "Email (Gmail API)" section for full setup. Get the client id/secret from an OAuth
# 2.0 Client ID (Web application type) in Google Cloud Console, then run
# `node scripts/gmail-oauth-setup.mjs` to obtain the refresh token.
NUXT_GMAIL_CLIENT_ID=
NUXT_GMAIL_CLIENT_SECRET=
NUXT_GMAIL_REFRESH_TOKEN=
NUXT_GMAIL_SENDER=
NUXT_GMAIL_FROM_NAME=IBS Ticketing System

# shared secret Vercel Cron sends back as `Authorization: Bearer <value>` when it triggers
# /api/cron/* routes (SLA sweep + Gmail inbox check) - set the same value as the CRON_SECRET
# env var in your Vercel project. Leave blank only for local testing.
NUXT_CRON_SECRET=

# comma-separated list of origins allowed to call POST /api/tickets cross-origin (e.g. to embed
# a contact form directly on your marketing site). Leave blank to only allow this app's own
# /portal page (same-origin requests are never subject to CORS either way).
NUXT_PUBLIC_PORTAL_CORS_ORIGINS=

# session cookie signing secret (32+ random chars)
NUXT_SESSION_PASSWORD=

# web push (VAPID) - generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
NUXT_PUBLIC_VAPID_PUBLIC_KEY=
NUXT_VAPID_PRIVATE_KEY=
NUXT_VAPID_SUBJECT=mailto:you@example.com

# used to build links in emails (invite links, etc.)
NUXT_SITE_URL=http://localhost:3000
